# 本地开发；其余参数沿用代码和 Compose 默认值
QIWEN_WEB_PORT=23000
QIWEN_ENV=development
QIWEN_CORS_ORIGINS=http://localhost:23000,http://127.0.0.1:23000

# 聊天保持 mock，先接入 embedding
QIWEN_MODEL_MODE=mock
QIWEN_MODEL_BASE_URL=
QIWEN_MODEL_API_KEY=
QIWEN_MODEL_NAME=
QIWEN_EMBEDDING_MODEL=text-embedding-3-small

# 古籍混合召回与本地排序；0.7 门槛固定在代码中
QIWEN_RAG_MODE=hybrid
QIWEN_INSTALL_KNOWLEDGE=true
QIWEN_INSTALL_RERANK=true
QIWEN_RAG_RERANK_MODE=cross_encoder
QIWEN_CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
QIWEN_CROSS_ENCODER_DEVICE=cpu
QIWEN_RAG_MMR_LAMBDA=0.7
QIWEN_RAG_MMR_EMBEDDING_BACKEND=local
QIWEN_MMR_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
