# Local development and Docker Compose overrides. Compose works without a .env file.
# In production, set QIWEN_ENV=production and a long random secret.
QIWEN_WEB_PORT=23000
QIWEN_ENV=development
QIWEN_SECRET_KEY=
QIWEN_CORS_ORIGINS=http://localhost:23000,http://127.0.0.1:23000
QIWEN_MODEL_MODE=mock
QIWEN_RAG_MODE=mock

# For QIWEN_MODEL_MODE=openai_compatible:
QIWEN_MODEL_BASE_URL=
QIWEN_MODEL_API_KEY=
QIWEN_MODEL_NAME=
QIWEN_MODEL_TIMEOUT=45
QIWEN_MODEL_RETRIES=2

# Role names default to QIWEN_MODEL_NAME when blank.
# Each role also accepts _TIMEOUT and _RETRIES suffixes, e.g.:
# QIWEN_MODEL_SAFETY_PREFLIGHT_TIMEOUT=15
# QIWEN_MODEL_SAFETY_PREFLIGHT_RETRIES=1
QIWEN_MODEL_INQUIRY=
QIWEN_MODEL_SAFETY_PREFLIGHT=
QIWEN_MODEL_SUMMARY=
QIWEN_MODEL_PROFILE_EXTRACTION=
QIWEN_MODEL_RETRIEVAL_EVALUATION=
QIWEN_MODEL_QUERY_REWRITE=
QIWEN_MODEL_BIANZHENG=
QIWEN_MODEL_FORMULA=
QIWEN_MODEL_HERB=
QIWEN_MODEL_SYNTHESIS=
QIWEN_MODEL_REVIEWER=

# For QIWEN_RAG_MODE=hybrid (Docker builds the optional Chroma dependency when true):
QIWEN_INSTALL_KNOWLEDGE=false
QIWEN_EMBEDDING_MODEL=

# Optional standalone MCP (install backend/requirements-tools.txt separately).
# stdio binds only this user's profile; HTTP ignores the stdio binding and uses a login Bearer token.
# Use the same QIWEN_DATA_DIR and QIWEN_SECRET_KEY as the API for HTTP identity verification.
QIWEN_MCP_USER_ID=
QIWEN_MCP_ISSUER_URL=http://127.0.0.1:23000
QIWEN_MCP_RESOURCE_URL=http://127.0.0.1:28001/mcp
