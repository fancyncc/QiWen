# Local development and Docker Compose overrides. Compose works without a .env file.
# In production, set QIWEN_ENV=production and a long random secret.
QIWEN_WEB_PORT=23000
QIWEN_ENV=development
QIWEN_SECRET_KEY=
QIWEN_CORS_ORIGINS=http://localhost:23000,http://127.0.0.1:23000
QIWEN_MODEL_MODE=mock
QIWEN_RAG_MODE=mock

# For QIWEN_MODEL_MODE=openai_compatible:
QIWEN_MODEL_BASE_URL=
QIWEN_MODEL_API_KEY=
QIWEN_MODEL_NAME=

# For QIWEN_RAG_MODE=hybrid (Docker builds the optional Chroma dependency when true):
QIWEN_INSTALL_KNOWLEDGE=false
QIWEN_EMBEDDING_MODEL=
